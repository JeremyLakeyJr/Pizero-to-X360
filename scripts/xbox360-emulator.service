# Xbox 360 Controller Emulator - Systemd Service
#
# This systemd service automatically starts the Xbox 360 controller emulator
# on boot using raw-gadget for proper xpad driver binding.
#
# IMPORTANT: The paths below (/home/lakey/Pizero-to-X360) are placeholders.
# The install.sh script will automatically replace them with the actual
# installation directory when installing the service.
#
# Installation:
#   1. The install.sh script will automatically install this service
#   2. Or manually: sudo cp scripts/xbox360-emulator.service /etc/systemd/system/
#   3. Update paths in the service file to match your installation directory
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable xbox360-emulator.service
#   6. sudo systemctl start xbox360-emulator.service
#
# Usage:
#   Start:   sudo systemctl start xbox360-emulator
#   Stop:    sudo systemctl stop xbox360-emulator
#   Status:  sudo systemctl status xbox360-emulator
#   Logs:    sudo journalctl -u xbox360-emulator -f
#   Enable:  sudo systemctl enable xbox360-emulator
#   Disable: sudo systemctl disable xbox360-emulator
#

[Unit]
Description=Xbox 360 Controller Emulator for Raspberry Pi Zero (raw-gadget)
Documentation=https://github.com/JeremyLakeyJr/Pizero-to-X360
After=network.target multi-user.target
Wants=network.target

[Service]
Type=simple
# Load raw-gadget module if not already loaded
ExecStartPre=/bin/sh -c 'modprobe raw_gadget 2>/dev/null || true'
# Start the raw-gadget emulator
ExecStart=/home/lakey/Pizero-to-X360/bin/xbox360_raw_emulator
# Unload module on stop
ExecStopPost=/bin/sh -c 'sleep 1 && rmmod raw_gadget 2>/dev/null || true'
Restart=on-failure
RestartSec=5
User=root
WorkingDirectory=/home/lakey/Pizero-to-X360
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
